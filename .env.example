# GEMINI_API_KEY: Required for Gemini AI API calls (SHE-SHIELD Guardian & Threat Analyzer).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ENCRYPTION_SECRET: 32+ character secret used to encrypt sensitive safety records at rest.
# Optional in local dev (falls back to a generated local key in ./data/.key).
ENCRYPTION_SECRET=

# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER:
# Optional SMS gateway credentials for dispatching real emergency SMS alerts.
# When omitted, the app runs in clearly labeled manual-SMS / simulation mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
